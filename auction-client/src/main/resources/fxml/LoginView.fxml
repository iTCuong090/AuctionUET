<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="18" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionuet.client.view.LoginController">
    <children>
        <!-- Tiêu đề -->
        <Label styleClass="text-heading" text="Đăng nhập">
            <font><Font name="System Bold" size="28.0" /></font>
        </Label>
        <Label styleClass="text-secondary" text="Đăng nhập để truy cập hệ thống đấu giá">
            <font><Font size="13.0" /></font>
            <VBox.margin><Insets bottom="10.0" /></VBox.margin>
        </Label>

        <!-- Server Configuration -->
        <VBox spacing="5.0">
            <Label styleClass="text-secondary" text="Cấu hình Server" />
            <HBox spacing="10.0">
                <TextField fx:id="serverHostField" promptText="Host (VD: localhost)" text="localhost" HBox.hgrow="ALWAYS" />
                <TextField fx:id="serverPortField" promptText="Port" text="8888" prefWidth="80.0" />
            </HBox>
        </VBox>

        <!-- Form fields -->
        <VBox spacing="5.0">
            <Label styleClass="text-secondary" text="Tên đăng nhập" />
            <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập..." />
        </VBox>

        <VBox spacing="5.0">
            <Label styleClass="text-secondary" text="Mật khẩu" />
            <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu..." />
        </VBox>

        <!-- Error label -->
        <Label fx:id="errorLabel" styleClass="error-label" visible="false" wrapText="true" />

        <!-- Nút Đăng nhập -->
        <Button fx:id="loginButton" text="Đăng nhập" onAction="#handleLogin" maxWidth="Infinity" styleClass="main-login-btn">
            <VBox.margin><Insets top="8.0" /></VBox.margin>
        </Button>

        <!-- Link chuyển sang Đăng ký -->
        <HBox alignment="CENTER" spacing="5.0">
            <children>
                <Label styleClass="text-secondary" text="Bạn chưa có tài khoản?" />
                <Hyperlink fx:id="registerLink" text="Đăng ký" onAction="#handleSwitchToRegister" />
            </children>
            <VBox.margin><Insets top="5.0" /></VBox.margin>
        </HBox>
    </children>
</VBox>