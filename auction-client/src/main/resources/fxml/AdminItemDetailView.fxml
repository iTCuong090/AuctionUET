<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" styleClass="dark-bg-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionuet.client.view.AdminItemDetailController">
    <content>
        <VBox spacing="22.0" styleClass="dark-bg">
            <padding><Insets bottom="28.0" left="28.0" right="28.0" top="18.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBack" styleClass="approval-action-button" text="Quay lại" />
                        <Label styleClass="text-heading" text="Chi tiết kiểm duyệt sản phẩm">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                    </children>
                </HBox>
                <HBox spacing="22.0">
                    <children>
                        <StackPane prefHeight="250.0" prefWidth="250.0" styleClass="approval-detail-image">
                            <children>
                                <Label fx:id="imagePlaceholderLabel" styleClass="text-secondary" text="Chưa có ảnh" />
                                <ImageView fx:id="productImageView" fitHeight="230.0" fitWidth="230.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </StackPane>
                        <VBox spacing="12.0" styleClass="approval-detail-panel" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label fx:id="nameLabel" styleClass="approval-detail-title" text="Sản phẩm" wrapText="true" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="approvalStatusLabel" text="--" />
                                    </children>
                                </HBox>
                                <Label fx:id="priceLabel" styleClass="approval-detail-price" text="0 VND" />
                                <Label fx:id="sellerLabel" styleClass="text-secondary" text="Seller: --" />
                                <Label fx:id="typeLabel" styleClass="text-secondary" text="Loại: --" />
                                <Label fx:id="conditionLabel" styleClass="text-secondary" text="Tình trạng: --" />
                                <Label fx:id="createdLabel" styleClass="text-secondary" text="Tạo lúc: --" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="12.0" styleClass="approval-detail-panel">
                    <children>
                        <Label styleClass="text-primary" text="Mô tả"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label fx:id="descriptionLabel" styleClass="text-detail" text="--" wrapText="true" />
                        <Label styleClass="text-primary" text="Thông số bổ sung"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label fx:id="specificationsLabel" styleClass="text-detail" text="--" wrapText="true" />
                    </children>
                </VBox>
                <HBox fx:id="actionArea" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleApprove" styleClass="approval-action-button" text="Duyệt" />
                        <Button mnemonicParsing="false" onAction="#handleReject" styleClass="approval-action-button, danger-action-button" text="Từ chối" />
                    </children>
                </HBox>
                <Label fx:id="statusMessage" styleClass="text-secondary" text="" wrapText="true" />
            </children>
        </VBox>
    </content>
</ScrollPane>
