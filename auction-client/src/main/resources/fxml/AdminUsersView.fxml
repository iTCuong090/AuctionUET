<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="18.0" styleClass="dark-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionuet.client.view.AdminUsersController">
    <padding>
        <Insets bottom="18.0" left="12.0" right="12.0" top="8.0" />
    </padding>
    <children>
        <Label styleClass="text-heading" text="Quản lý người dùng">
            <font><Font name="System Bold" size="25.0" /></font>
        </Label>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <TextField fx:id="searchField" onAction="#handleSearch" promptText="Tìm username" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="roleFilter" prefWidth="135.0" promptText="Vai trò" />
                <ComboBox fx:id="statusFilter" prefWidth="135.0" promptText="Trạng thái" />
                <Button mnemonicParsing="false" onAction="#handleSearch" text="Tìm" />
                <Button mnemonicParsing="false" onAction="#handleReset" text="Đặt lại" />
            </children>
        </HBox>
        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="usernameColumn" prefWidth="250.0" text="Username" />
                <TableColumn fx:id="roleColumn" prefWidth="140.0" text="Vai trò" />
                <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Trạng thái" />
                <TableColumn fx:id="actionColumn" prefWidth="130.0" text="Thao tác" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label fx:id="statusLabel" styleClass="text-secondary" text="" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleSearch" text="Làm mới" />
            </children>
        </HBox>
    </children>
</VBox>
