<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" styleClass="dark-bg-scroll" style="-fx-border-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionuet.client.view.HomeController">
    <content>
        <VBox spacing="25.0" styleClass="dark-bg">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <StackPane prefHeight="220.0" style="-fx-background-color: linear-gradient(to right bottom, #0f3460, #e94560); -fx-background-radius: 15;">
                    <children>
                        <VBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Label text="🔥 Đấu giá mùa hè - Săn đồ công nghệ giá cực hời!" textFill="WHITE">
                                    <font><Font name="System Bold" size="28.0" /></font>
                                </Label>
                                <Label text="Hàng nghìn sản phẩm đang chờ bạn khám phá. Đừng bỏ lỡ!" textFill="#e0e0e0">
                                    <font><Font size="16.0" /></font>
                                </Label>
                                <Button mnemonicParsing="false" style="-fx-background-color: #4ecdc4; -fx-text-fill: #1a1a2e; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 12 30; -fx-font-size: 16px;" text="Khám phá ngay" />
                            </children>
                        </VBox>
                    </children>
                </StackPane>

                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <VBox alignment="CENTER" prefWidth="250.0" styleClass="card-bg" style="-fx-background-radius: 12; -fx-padding: 25;">
                            <children>
                                <Label text="📦"><font><Font size="40.0" /></font></Label>
                                <Label fx:id="statAuctionCount" styleClass="text-primary" text="...">
                                    <font><Font name="System Bold" size="26.0" /></font>
                                </Label>
                                <Label styleClass="text-secondary" text="Sản phẩm đang đấu" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefWidth="250.0" styleClass="card-bg" style="-fx-background-radius: 12; -fx-padding: 25;">
                            <children>
                                <Label text="🟢"><font><Font size="40.0" /></font></Label>
                                <Label fx:id="statRunningCount" styleClass="text-primary" text="...">
                                    <font><Font name="System Bold" size="26.0" /></font>
                                </Label>
                                <Label styleClass="text-secondary" text="Đang diễn ra" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefWidth="250.0" styleClass="card-bg" style="-fx-background-radius: 12; -fx-padding: 25;">
                            <children>
                                <Label text="✅"><font><Font size="40.0" /></font></Label>
                                <Label fx:id="statFinishedCount" styleClass="text-primary" text="...">
                                    <font><Font name="System Bold" size="26.0" /></font>
                                </Label>
                                <Label styleClass="text-secondary" text="Đã kết thúc" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label styleClass="text-heading" text="⏰ Sắp kết thúc">
                    <font><Font name="System Bold" size="24.0" /></font>
                    <VBox.margin><Insets top="20.0" /></VBox.margin>
                </Label>

                <HBox fx:id="endingSoonBox" spacing="20.0" styleClass="card-bg" style="-fx-padding: 30; -fx-background-radius: 12; -fx-border-color: #0f3460; -fx-border-radius: 12;">
                    <children>
                        <Label fx:id="endingSoonPlaceholder" styleClass="text-secondary" text="Đang tải dữ liệu..." style="-fx-font-style: italic;">
                            <font><Font size="16.0" /></font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>