<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionuet.client.view.MyItemsController">
    <children>
        <ScrollPane fitToWidth="true" styleClass="dark-bg-scroll" style="-fx-border-color: transparent;">
            <content>
                <VBox spacing="20.0" styleClass="dark-bg">
                    <padding>
                        <Insets bottom="95.0" left="30.0" right="30.0" top="20.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Label styleClass="text-heading" text="📦 Vật phẩm của tôi">
                                <font><Font name="System Bold" size="24.0" /></font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnRefresh" mnemonicParsing="false" style="-fx-background-color: #3b3148; -fx-text-fill: white; -fx-font-size: 22px; -fx-background-radius: 8; -fx-min-width: 42; -fx-min-height: 42;" text="⟳" />
                        </HBox>

                        <VBox fx:id="createItemHost" managed="false" visible="false" />

                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <TextField fx:id="searchField" promptText="Tìm kiếm vật phẩm..." styleClass="text-field" HBox.hgrow="ALWAYS" />
                            <Button mnemonicParsing="false" onAction="#handleSearch" style="-fx-background-color: #4ecdc4; -fx-text-fill: #1a1a2e;" text="🔍 Tìm" />
                        </HBox>

                        <Label fx:id="statusLabel" styleClass="text-secondary" text="Đang tải danh sách..." />
                        <FlowPane fx:id="itemGrid" hgap="20.0" vgap="20.0" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
        <Button fx:id="btnToggleCreate" mnemonicParsing="false" style="-fx-background-color: white; -fx-text-fill: #111827; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 14 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 2);" text="+  New" StackPane.alignment="BOTTOM_RIGHT">
            <StackPane.margin>
                <Insets bottom="24.0" right="28.0" />
            </StackPane.margin>
        </Button>
    </children>
</StackPane>
