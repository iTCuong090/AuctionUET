<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionuet.client.view.MainController">    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #1a252f;" BorderPane.alignment="CENTER">
            <children>
                <StackPane>
                    <Circle fill="WHITE" radius="28.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="2.0" />

                    <ImageView fitHeight="55.0" fitWidth="55.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/UET.png" />
                        </image>
                    </ImageView>
                </StackPane>
                <Label text="AuctionUET">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                    <textFill>
                        <LinearGradient endX="1.0" endY="1.0">
                            <stops>
                                <Stop>
                                    <color>
                                        <Color red="0.0658000037074089" green="0.5460582375526428" blue="0.9399999976158142" />
                                    </color>
                                </Stop>
                                <Stop offset="1.0">
                                    <color>
                                        <Color red="1.0" green="1.0" blue="1.0" />
                                    </color>
                                </Stop>
                            </stops>
                        </LinearGradient>
                    </textFill>
                </Label>
                <HBox alignment="CENTER_RIGHT" prefHeight="70.0" prefWidth="200.0" spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Trang chủ">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleLogin" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Đăng nhập">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#handleRegister" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Đăng ký ngay">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                            <padding>
                                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="25.0" styleClass="hero-section" BorderPane.alignment="CENTER">            <children>
                <Label fx:id="titleLabel" text="Săn Đồ Ngon - Giá Cực Hời" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="48.0" />
                    </font>
                </Label>
                <Label fx:id="subtitleLabel" text="Nền tảng đấu giá uy tín nhất. Tham gia ngay để không bỏ lỡ những món đồ độc lạ!" textFill="#444a4d">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <Button fx:id="startButton" mnemonicParsing="false" onAction="#onStartClicked" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="🚀 Bắt đầu ngay">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </Button>

                <Label fx:id="statusLabel" text="">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="BOTTOM_RIGHT" prefHeight="30.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <Pane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                <Label alignment="CENTER" contentDisplay="CENTER" text="AuctionUET" translateX="20.0">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>
                <Pane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                <Label fx:id="versionLabel" text="v1.0" textFill="#7f8c8d">
                    <font>
                        <Font size="10.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets bottom="10.0" right="15.0" />
            </padding>
        </HBox>
    </bottom>
   <effect>
      <InnerShadow>
         <color>
            <Color green="0.6396552324295044" blue="1.0" />
         </color>
      </InnerShadow>
   </effect>
</BorderPane>
