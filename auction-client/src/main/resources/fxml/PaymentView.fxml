<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" styleClass="dark-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionuet.client.view.PaymentController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Group>
                    <children>
                        <Rectangle arcHeight="3.0" arcWidth="3.0" fill="#0374B5" height="18.0" width="25.0" />
                        <Rectangle fill="#f5f5f5" height="4.0" layoutY="5.0" width="25.0" />
                        <Rectangle fill="#f5f5f5" height="2.0" layoutX="4.0" layoutY="13.0" opacity="0.9" width="8.0" />
                    </children>
                </Group>
                <Label styleClass="text-heading" text="Thanh toán đấu giá">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
            </children>
        </HBox>
        <HBox spacing="12.0">
            <children>
                <Button fx:id="btnAllPayments" mnemonicParsing="false" styleClass="payment-filter-chip" text="Tất cả" />
                <Button fx:id="btnPendingPayments" mnemonicParsing="false" styleClass="payment-filter-chip" text="Chưa thanh toán" />
                <Button fx:id="btnPaidPayments" mnemonicParsing="false" styleClass="payment-filter-chip" text="Đã thanh toán (30 ngày)" />
            </children>
        </HBox>
        <Label fx:id="statusLabel" styleClass="text-secondary" text="Đang tải danh sách..." />
        <ScrollPane fx:id="paymentScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="dark-bg-scroll" style="-fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="paymentContent" spacing="24.0">
                    <children>
                        <TilePane fx:id="paymentGrid" hgap="20.0" prefColumns="4" tileAlignment="TOP_LEFT" vgap="20.0" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
