<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="auth-form-scroll" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionuet.client.view.RegisterController">
    <content>
<VBox alignment="CENTER" maxWidth="Infinity" spacing="14">
    <padding>
        <Insets bottom="18.0" left="0.0" right="28.0" top="8.0" />
    </padding>
    <children>
        <!-- Tiêu đề -->
        <Label styleClass="text-heading" text="Tạo tài khoản mới">
            <font><Font name="System Bold" size="26.0" /></font>
        </Label>
        <Label styleClass="text-secondary" text="Điền thông tin bên dưới để đăng ký">
            <font><Font size="13.0" /></font>
            <VBox.margin><Insets bottom="5.0" /></VBox.margin>
        </Label>

        <!-- Server Configuration -->
        <VBox spacing="5.0">
            <Label styleClass="text-secondary" text="Cấu hình Server" />
            <HBox spacing="10.0">
                <TextField fx:id="serverHostField" promptText="Host (VD: localhost)" text="localhost" HBox.hgrow="ALWAYS" />
                <TextField fx:id="serverPortField" promptText="Port" text="8888" prefWidth="80.0" />
            </HBox>
        </VBox>

        <!-- Form fields -->
        <VBox spacing="5.0">
            <Label styleClass="text-secondary" text="Tên đăng nhập" />
            <TextField fx:id="usernameField" promptText="Tên đăng nhập (≥ 3 ký tự)" />
        </VBox>

        <VBox spacing="5.0">
            <Label styleClass="text-secondary" text="Email" />
            <TextField fx:id="emailField" promptText="Email của bạn" />
        </VBox>

        <VBox spacing="5.0">
            <Label styleClass="text-secondary" text="Mật khẩu" />
            <PasswordField fx:id="passwordField" promptText="Mật khẩu (≥ 8 ký tự)" />
        </VBox>

        <VBox spacing="5.0">
            <Label styleClass="text-secondary" text="Nhập lại mật khẩu" />
            <PasswordField fx:id="confirmField" promptText="Xác nhận mật khẩu" />
        </VBox>

        <VBox spacing="5.0">
            <Label styleClass="text-secondary" text="Vai trò" />
            <ComboBox fx:id="roleComboBox" promptText="Chọn vai trò" maxWidth="Infinity" styleClass="combo-box" />
        </VBox>

        <!-- Error label -->
        <Label fx:id="errorLabel" styleClass="error-label" visible="false" wrapText="true" />

        <!-- Nút Đăng ký -->
        <Button fx:id="registerButton" text="Đăng ký" onAction="#handleRegister" maxWidth="Infinity" styleClass="main-login-btn">
            <VBox.margin><Insets top="5.0" /></VBox.margin>
        </Button>

        <!-- Link chuyển sang Đăng nhập -->
        <HBox alignment="CENTER" spacing="5.0">
            <children>
                <Label styleClass="text-secondary" text="Đã có tài khoản?" />
                <Hyperlink fx:id="loginLink" text="Đăng nhập" onAction="#handleSwitchToLogin" />
            </children>
        </HBox>
    </children>
</VBox>
    </content>
</ScrollPane>
