<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionuet.client.view.RegisterController">
    <padding><Insets bottom="50" left="200" right="200" top="50"/></padding>

    <Label text="Tạo tài khoản mới" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    <TextField fx:id="usernameField" promptText="Tên đăng nhập (≥ 3 ký tự)" />
    <TextField fx:id="emailField" promptText="Email" />
    <PasswordField fx:id="passwordField" promptText="Mật khẩu (≥ 8 ký tự)" />
    <PasswordField fx:id="confirmField" promptText="Nhập lại mật khẩu" />
    <ComboBox fx:id="roleComboBox" promptText="Chọn vai trò" maxWidth="Infinity" style="-fx-font-size: 14; -fx-background-color: #16213e; -fx-text-fill: white; -fx-border-color: #0f3460; -fx-border-radius: 8;" />
    <Label fx:id="errorLabel" styleClass="error-label" visible="false" />
    <Button fx:id="registerButton" text="Đăng ký" onAction="#handleRegister" maxWidth="Infinity" />
    <Hyperlink fx:id="loginLink" text="Quay về Trang chủ" onAction="#handleBack" />
</VBox>