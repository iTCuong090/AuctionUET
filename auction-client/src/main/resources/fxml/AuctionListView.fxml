<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #1a1a2e;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auctionuet.client.view.AuctionListController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
    <children>
        <Label text="🏛 Danh sách phiên đấu giá">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
         <textFill>
            <LinearGradient endX="1.0" endY="1.0">
               <stops>
                  <Stop>
                     <color>
                        <Color red="0.009999999776482582" green="1.0" blue="0.973281979560852" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="1.0" green="1.0" blue="1.0" />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </textFill>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <ComboBox fx:id="filterComboBox" prefWidth="150.0" promptText="Lọc trạng thái..." styleClass="combo-box" />
                <TextField fx:id="searchField" promptText="Tìm kiếm tên sản phẩm..." styleClass="text-field" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" style="-fx-background-color: #4ecdc4; -fx-text-fill: #1a1a2e;" text="🔍 Tìm" />
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background: #1a1a2e; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="auctionGrid" hgap="20.0" vgap="20.0" />
            </content>
        </ScrollPane>

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" style="-fx-background-color: #16213e; -fx-text-fill: white;" text="&lt;" />
                <Button mnemonicParsing="false" style="-fx-background-color: #e94560; -fx-text-fill: white;" text="1" />
                <Button mnemonicParsing="false" style="-fx-background-color: #16213e; -fx-text-fill: white;" text="2" />
                <Button mnemonicParsing="false" style="-fx-background-color: #16213e; -fx-text-fill: white;" text="3" />
                <Button mnemonicParsing="false" style="-fx-background-color: #16213e; -fx-text-fill: white;" text="&gt;" />
            </children>
        </HBox>
    </children>
   <effect>
      <InnerShadow>
         <color>
            <Color red="0.019600000232458115" green="0.885341227054596" blue="0.9800000190734863" />
         </color>
      </InnerShadow>
   </effect>
</VBox>
